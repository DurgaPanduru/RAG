{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "redis:6379"
  },
  "Seq": {
    "Url": "http://seq:80"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:4200"
  },
  "LangChain": {
    "GrpcUrl": "http://langchain:50051",
    "HttpUrl": "http://langchain:8000"
  },
  "MinIO": {
    "Endpoint": "minio:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "documents",
    "UseSSL": false
  },
  "Cache": {
    "SemanticSimilarityThreshold": 0.92,
    "TtlHours": 24
  }
}
