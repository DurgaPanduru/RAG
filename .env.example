# ==========================================
# GenAI RAG Application - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values

# ==========================================
# REQUIRED: Anthropic API Configuration
# ==========================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ==========================================
# Service Ports (External Access)
# ==========================================
FRONTEND_PORT=4200
GATEWAY_PORT=5000
BACKEND_PORT=5001
LANGCHAIN_PORT=8000
LANGCHAIN_GRPC_PORT=50051
CHROMA_PORT=8001
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
SEQ_PORT=5341

# ==========================================
# Service URLs (Docker Internal)
# ==========================================
GATEWAY_URL=http://gateway:8080
BACKEND_URL=http://backend:8080
LANGCHAIN_URL=http://langchain:8000
LANGCHAIN_GRPC_URL=http://langchain:50051

# ==========================================
# MinIO Data Lake Configuration
# ==========================================
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=documents
MINIO_REGION=us-east-1

# ==========================================
# Redis Cache Configuration
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECTION=redis:6379
REDIS_MAXMEMORY=2gb
REDIS_EVICTION_POLICY=allkeys-lru

# ==========================================
# ChromaDB Vector Store Configuration
# ==========================================
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=/chroma/chroma
CHROMA_TELEMETRY_ENABLED=false

# ==========================================
# Application Settings
# ==========================================
# Environment: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development
PYTHON_ENV=development

# Logging level: Debug, Info, Warning, Error
LOG_LEVEL=Info

# Enable debug mode
DEBUG_MODE=false

# ==========================================
# RAG Configuration
# ==========================================
# Document processing
MAX_DOCUMENT_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# Caching
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_HOURS=24

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ==========================================
# Claude API Settings
# ==========================================
CLAUDE_MODEL_PRIMARY=claude-sonnet-4-5
CLAUDE_MODEL_GUARDRAILS=claude-haiku-4-5
CLAUDE_MAX_TOKENS=2048
CLAUDE_TEMPERATURE=0.7
CLAUDE_TIMEOUT_SECONDS=60
CLAUDE_PROMPT_CACHING_ENABLED=true

# ==========================================
# Monitoring Configuration
# ==========================================
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_SCRAPE_INTERVAL=15s

GRAFANA_URL=http://grafana:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

SEQ_URL=http://seq:80
SEQ_API_KEY=

# ==========================================
# Security Settings
# ==========================================
# JWT Authentication (if enabled)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ISSUER=RAG-API
JWT_AUDIENCE=RAG-Client
JWT_EXPIRATION_MINUTES=60

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5000

# ==========================================
# Docker Configuration
# ==========================================
COMPOSE_PROJECT_NAME=rag
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ==========================================
# Database Configuration (Future Use)
# ==========================================
# Uncomment if you add a relational database
# DATABASE_HOST=postgres
# DATABASE_PORT=5432
# DATABASE_NAME=rag_db
# DATABASE_USER=rag_user
# DATABASE_PASSWORD=your-db-password

# ==========================================
# Production Settings (Uncomment for Prod)
# ==========================================
# USE_TLS=true
# CERTIFICATE_PATH=/certs/tls.crt
# PRIVATE_KEY_PATH=/certs/tls.key
# BACKEND_REPLICAS=3
# LANGCHAIN_REPLICAS=2
